    {
      "parameters": {
        "jsCode": "const d=$json.context.item,p=d.payload&&typeof d.payload==='object'&&!Array.isArray(d.payload)?d.payload:{};\nreturn [{json:{recovery:{dlq_id:d.id,lead_id:d.lead_id??null,workflow:d.workflow,operation:d.operation,error_type:d.error_type,error_message:d.error_message,attempt_count:Number(d.attempt_count||0),max_attempts:3,payload:p,idempotency_key:typeof p.idempotency_key==='string'&&p.idempotency_key?p.idempotency_key:null,recovery_mode:$json.context.recovery_mode,manual_dlq_id:$json.context.manual_dlq_id??null}}}];"
      },
      "id": "92622e46-2617-4f71-ab4f-637478d47b34",
      "name": "Normalize Recovery Context",
