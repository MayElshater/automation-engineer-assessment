    {
      "parameters": {
        "jsCode": "let x=$json.context,b=x.base,r=b.recovery,f=b.failure_classification,s=x.state,d=s.already_completed?'already_completed':f.class==='transient'&&r.attempt_count<r.max_attempts?'retryable':f.class==='permanent'?'permanent':f.class==='configuration'?'manual_required':r.attempt_count>=r.max_attempts?'exhausted':'manual_required';return[{json:{...b,original_operation_state:s,booking_state:x.booking,followup_state:x.followup,recovery_decision:{decision:d,reason:d,safe_to_execute:d==='retryable'}}}];"
      },
