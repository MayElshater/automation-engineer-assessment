    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH i AS(SELECT $1::jsonb c),k AS(SELECT x.* FROM idempotency_keys x,i WHERE x.key=i.c#>>'{recovery,idempotency_key}' LIMIT 1),b AS(SELECT x.* FROM bookings x,i WHERE x.id::text=i.c#>>'{recovery,payload,booking_id}' LIMIT 1),f AS(SELECT x.* FROM followups x,i WHERE x.id::text=i.c#>>'{recovery,payload,followup_id}' OR x.idempotency_key=i.c#>>'{recovery,idempotency_key}' LIMIT 1) SELECT jsonb_build_object('base',i.c,'state',jsonb_build_object('idempotency_key',i.c#>>'{recovery,idempotency_key}','status',case when i.c#>>'{recovery,idempotency_key}' is null then null when k.key is null then 'missing' else k.status end,'response_reference',k.response_reference,'expires_at',k.expires_at,'already_completed',coalesce(k.status='completed',false)),'booking',(select to_jsonb(b) from b),'followup',(select to_jsonb(f) from f)) context FROM i LEFT JOIN k ON true;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json), $execution.id] }}"
        }
      },
      "id": "8d654539-2721-4ae3-a871-b476eff1855e",
      "name": "Load Original Operation State",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1888,
