        992
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH i AS(SELECT $1::jsonb c),u AS(UPDATE dead_letter_queue d SET status='reprocessing' FROM i WHERE d.id=(i.c#>>'{context,item,id}')::uuid AND d.status='pending' RETURNING d.*) SELECT jsonb_build_object('claimed',exists(select 1 from u),'item',(select to_jsonb(u) from u),'recovery_mode', i.c#>>'{context,recovery_mode}','manual_dlq_id', i.c#>>'{context,manual_dlq_id}') context FROM i;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json), $execution.id] }}"
        }
      },
