      "typeVersion": 2,
      "position": [
        1408,
        1088
      ]
    },
    {
      "parameters": {
        "jsCode": "let e=String($json.recovery.error_type||'').toLowerCase(),t=['timeout','api_timeout','network_error','connection_reset','rate_limit','http_429','service_unavailable','http_502','http_503','http_504','temporary_unavailable'],p=['malformed_payload','invalid_payload','validation_error','unsupported_operation','missing_required_field'],g=['missing_credentials','authentication_failed','forbidden','invalid_configuration'],c=t.includes(e)?'transient':p.includes(e)?'permanent':g.includes(e)?'configuration':'unknown';return[{json:{...$json,failure_classification:{class:c,retryable:c==='transient',reason:'classified_'+c}}}];"
      },
      "id": "5d29214f-d54f-44af-b557-cd1fd7c342a5",
      "name": "Classify Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1712,
        1088
