      "id": "068b6bad-279d-478a-ac41-b270b3d7f572",
      "name": "Schedule Recovery Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        928
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH i AS (\n  SELECT\n    $1::jsonb AS c,\n    $1::jsonb #>> '{recovery_selection,recovery_mode}' AS mode,\n    NULLIF(\n      $1::jsonb #>> '{recovery_selection,manual_dlq_id}',\n      ''\n    )::uuid AS target\n),\n\nreopened AS (\n  UPDATE dead_letter_queue d\n  SET status = 'pending'\n  FROM i\n  WHERE i.mode = 'manual_targeted'\n    AND d.id = i.target\n    AND d.status = 'failed'\n  RETURNING d.*\n),\n\ncandidate AS (\n\n  -- If targeted failed row was reopened in this execution,\n  -- use UPDATE ... RETURNING directly.\n  SELECT r.*\n  FROM reopened r\n\n  UNION ALL\n\n  -- If targeted row was already pending, select it directly.\n  SELECT d.*\n  FROM dead_letter_queue d\n  CROSS JOIN i\n  WHERE i.mode = 'manual_targeted'\n    AND d.id = i.target\n    AND d.status = 'pending'\n    AND NOT EXISTS (SELECT 1 FROM reopened)\n\n  UNION ALL\n\n  -- Scheduled/manual-oldest recovery.\n  SELECT d.*\n  FROM dead_letter_queue d\n  CROSS JOIN i\n  WHERE i.mode IN ('scheduled', 'manual_oldest')\n    AND d.status = 'pending'\n  ORDER BY created_at, id\n  LIMIT 1\n)\n\nSELECT jsonb_build_object(\n  'item',\n  (SELECT to_jsonb(candidate) FROM candidate LIMIT 1),\n  'recovery_mode',\n  i.mode,\n  'manual_dlq_id',\n  i.target\n) AS context\nFROM i;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json), $execution.id] }}"
        }
      },
      "id": "2bee2ed7-c164-4a3b-b8fb-8f84de169f7a",
      "name": "Find Pending DLQ Work",
      "type": "n8n-nodes-base.postgres",
