    {
      "parameters": {},
      "id": "3b5d61a3-7e09-4187-a2a8-814e0b7b9b8b",
      "name": "Manual Recovery Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        80,
        736
      ]
    },
    {
      "parameters": {
