    },
    {
      "parameters": {
        "jsCode": "const out=JSON.parse(JSON.stringify($json));const e=out.booking_event??{};const missing=['event_id','event_type','booking_id','lead_id'].filter(k=>!e[k]);const invalid=[];if(e.event_type&&!['booked','rescheduled','cancelled','converted'].includes(e.event_type))invalid.push('event_type');if(e.lead_id&&!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(e.lead_id))invalid.push('lead_id');if(['booked','rescheduled'].includes(e.event_type)){if(!e.scheduled_at)missing.push('scheduled_at');else if(!Number.isFinite(Date.parse(e.scheduled_at)))invalid.push('scheduled_at')}out.booking_validation={valid:missing.length===0&&invalid.length===0,missing_fields:[...new Set(missing)],invalid_fields:[...new Set(invalid)]};return[{json:out}];"
      },
