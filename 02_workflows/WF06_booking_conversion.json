      "parameters": {
        "jsCode": "const input=$json.body??$json;const data=input.data??input;const trim=v=>v==null?null:String(v).trim()||null;const rawType=trim(data.event_type??data.type??data.event)?.toLowerCase();const aliases={booked:'booked',booking_created:'booked',scheduled:'booked',rescheduled:'rescheduled',booking_rescheduled:'rescheduled',cancelled:'cancelled',canceled:'cancelled',booking_cancelled:'cancelled',booking_canceled:'cancelled',converted:'converted',completed:'converted',conversion:'converted'};const eventId=trim(data.event_id??data.webhook_event_id??data.id);const source=trim(data.source??input.source)??'booking_webhook';const occurred=trim(data.occurred_at??data.created_at)??new Date().toISOString();return[{json:{booking_event:{event_id:eventId,event_type:aliases[rawType]??rawType,booking_id:trim(data.booking_id??data.external_booking_id??data.booking?.id),lead_id:trim(data.lead_id??data.metadata?.lead_id),scheduled_at:trim(data.scheduled_at??data.meeting_at??data.start_time),source,occurred_at:occurred}}}];"
      },
      "id": "940badaf-174c-4c89-a737-94277effdc36",
      "name": "Normalize Booking Event",
      "type": "n8n-nodes-base.code",
