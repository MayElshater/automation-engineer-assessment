    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH i AS(SELECT $1::jsonb e),b AS(INSERT INTO bookings(lead_id,external_booking_id,meeting_at,status,created_at,updated_at)SELECT (e->>'lead_id')::uuid,e->>'booking_id',(e->>'scheduled_at')::timestamptz,'scheduled',now(),now()FROM i ON CONFLICT(external_booking_id)DO UPDATE SET meeting_at=EXCLUDED.meeting_at,status='scheduled',updated_at=now()WHERE bookings.lead_id=EXCLUDED.lead_id RETURNING bookings.*),l AS(UPDATE leads SET crm_stage='meeting_booked',next_action='attend_meeting',updated_at=now()FROM i,b WHERE leads.id=b.lead_id RETURNING leads.*),c AS(UPDATE followups SET status='cancelled'FROM i,b WHERE followups.lead_id=b.lead_id AND(followups.status='scheduled'OR(followups.status='processing'AND EXISTS(SELECT 1 FROM idempotency_keys k WHERE k.key=followups.idempotency_key AND k.status='processing'AND k.expires_at<=now())))RETURNING followups.id),ev AS(INSERT INTO lead_events(lead_id,event_type,workflow_name,execution_id,payload,created_at)SELECT b.lead_id,'booking_created','WF06_booking_conversion',$2,jsonb_build_object('external_booking_id',b.external_booking_id,'booking_id',b.id,'meeting_at',b.meeting_at,'assigned_sales_rep_id',l.assigned_sales_rep_id,'source',i.e->>'source','event_id',i.e->>'event_id'),now()FROM i,b,l),fc AS(INSERT INTO lead_events(lead_id,event_type,workflow_name,execution_id,payload,created_at)SELECT b.lead_id,'booking_followups_cancelled','WF06_booking_conversion',$2,jsonb_build_object('external_booking_id',b.external_booking_id,'cancelled_count',(SELECT count(*)FROM c),'event_id',i.e->>'event_id'),now()FROM i,b WHERE EXISTS(SELECT 1 FROM c))SELECT i.e booking_event,to_jsonb(l)authoritative_lead,to_jsonb(b)booking,EXISTS(SELECT 1 FROM b)mutation_success,(SELECT count(*)FROM c)cancelled_count FROM i LEFT JOIN b ON true LEFT JOIN l ON true;",
