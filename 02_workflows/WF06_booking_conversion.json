    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH i AS(SELECT $1::jsonb j),fresh AS(INSERT INTO idempotency_keys(key,operation,lead_id,status,created_at)SELECT j#>>'{booking_event,idempotency_key}','booking_event',(j#>>'{booking_event,lead_id}')::uuid,'processing',now()FROM i ON CONFLICT(key)DO NOTHING RETURNING key,status),retry AS(UPDATE idempotency_keys SET status='processing',expires_at=NULL FROM i WHERE idempotency_keys.key=j#>>'{booking_event,idempotency_key}'AND idempotency_keys.status='failed' RETURNING idempotency_keys.key,idempotency_keys.status),claimed AS(SELECT * FROM fresh UNION ALL SELECT * FROM retry)SELECT i.j#>'{booking_event}'booking_event,EXISTS(SELECT 1 FROM claimed)booking_event_claimed,COALESCE((SELECT status FROM claimed LIMIT 1),(SELECT status FROM idempotency_keys k WHERE k.key=i.j#>>'{booking_event,idempotency_key}'),'missing')existing_status FROM i;",
